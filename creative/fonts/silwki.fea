languagesystem latn dflt;


# GPOS 


lookup mark {
  lookupflag 0;
  markClass [\e \w \o \I \a \u \E \W \U \A \i \O ] <anchor -250 200> @vowel;
  pos base [\l \Y \q \d \p \X \k \f \r \s \g \j \c \n \z \m \v \b \t \H \K \x \P \D \Q \y \L \J \G \S \R \F \B \V \M \Z \N \C \h \T \uni25CC ] <anchor 250 200> mark @vowel;
} mark;

feature mark {

 script latn;
     language dflt ;
      lookup mark;
} mark;
#Mark attachment classes (defined in GDEF, used in lookupflags)

@GDEF_Simple = [\l \Y \q \d \p \X \k \f \r \s \g \j \c \n \z \m \v \b \t \grave \H \K \x \P \D \Q \y \L 
	\J \G \S \R \F \B \V \M \Z \N \C \h \T \uni25CC ];
@GDEF_Mark = [\e \w \o \I \a \u \E \W \U \A \i \O \acutecomb \uni0317 \gravecomb \uni0316 
	\uni0302 \uni032D \uni030C \uni032C \uni0307 \dotbelowcomb \uni0308 \uni0324 
	\uni0304 \uni0331 ];

table GDEF {
  GlyphClassDef @GDEF_Simple, , @GDEF_Mark, ;

} GDEF;

