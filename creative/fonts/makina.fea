languagesystem latn dflt;


# GPOS 


lookup mark {
  lookupflag 0;
  markClass [\A \E \I \O \U \W \a \e \i \o \u \w ] <anchor -200 200> @vowel;
  pos base [\B \C \D \F \G \H \J \K \L \M \N \P \Q \R \S \T \V \X \Y \Z \b \c \d \f \g \h \j \k \l \m \n \p \q \r \s \t \v \x \y \z \uni25CC ] <anchor 200 200> mark @vowel;
} mark;

feature mark {

 script latn;
     language dflt ;
      lookup mark;
} mark;
#Mark attachment classes (defined in GDEF, used in lookupflags)

@GDEF_Simple = [\B \C \D \F \G \H \J \K \L \M \N \P \Q \R \S \T \V \X \Y \Z \b \c \d \f \g \h \j \k \l \m 
	\n \p \q \r \s \t \v \x \y \z \uni25CC ];
@GDEF_Mark = [\A \E \I \O \U \W \a \e \i \o \u \w ];

table GDEF {
  GlyphClassDef @GDEF_Simple, , @GDEF_Mark, ;

} GDEF;

