#!/usr/local/bin/fontforge
Open($1)
Print("あなたが使っているFontForgeのバージョンは ", $version, " です。")
Print($fontname, "のEM値（文字全体の高さ）は ", $em, "px です。")
Print($fontname, "のアセンダ値（ベースラインより上の高さ）は ", $ascent, "px です。")
Print($fontname, "のディセンダ値（ベースラインより下の高さ）は ", $descent, "px です。")
planetanchorpointy = $ascent - ($em / 2)
Print($fontname, "の惑星記号（母音記号）用アンカーポイント座標（Y軸）は ", planetanchorpointy, "px です。")
if($fontname == "Kodito" || $fontname == "Lozegw" || $fontname == "Silwki" || $fontname == "Xavani" || $fontname == "Xidili" || $fontname == "Lekuta" || $fontname == "Xesada")
if($fontname == "Kodito")
abovesatelliteanchorpointy = $ascent - ($em / 2)
belowsatelliteanchorpointy = $ascent - ($em / 2)
endif
if($fontname == "Lozegw" || $fontname == "Silwki" || $fontname == "Xavani" || $fontname == "Xidili" || $fontname == "Lekuta" || $fontname == "Xesada")
abovesatelliteanchorpointy = $ascent - $descent / 2
belowsatelliteanchorpointy = -1 * $descent / 2
endif
Print($fontname, "の上部衛星記号（朗唱記号）用アンカーポイント座標（Y軸）は ", abovesatelliteanchorpointy, "px です。")
Print($fontname, "の下部衛星記号（朗唱記号）用アンカーポイント座標（Y軸）は ", belowsatelliteanchorpointy, "px です。")
endif
Print($fontname, " には ", CharCnt(), " グリフあります。")
if($fontname == "Sulive" || $fontname == "Zosokw")
gsublookupslength = SizeOf(GetLookups("GSUB"))
gsublookups = Array(gsublookupslength)
gsublookupsindex = 0
gsublookups = GetLookups("GSUB")
Print($fontname, "のGSUBルックアップテーブルは", gsublookups)
gsublookupslength = SizeOf(gsublookups)
while(gsublookupsindex < gsublookupslength)
gsublookupinformation = GetLookupInfo(gsublookups[gsublookupsindex])
gsublookupsubtable = GetLookupSubtables(gsublookups[gsublookupsindex])
Print($fontname, "のGSUBルックアップ、", gsublookups[gsublookupsindex], "のGSUBルックアップ情報は", gsublookupinformation)

gsublookupinformationlength = SizeOf(gsublookupinformation)
gsublookupinformationarray = Array(gsublookupinformationlength)
gsublookupinformationarray = gsublookupinformation
gsublookupinformationindex = 0
while(gsublookupinformationindex < gsublookupinformationlength)
gsublookupinformationstring = gsublookupinformationarray[gsublookupinformationindex]
Print($fontname, "のGSUBルックアップ情報の個別情報は",  gsublookupinformationstring)
gsublookupinformationindex++
endloop

Print($fontname, "のGSUBルックアップ、", gsublookups[gsublookupsindex], "のGSUBルックアップサブテーブルは", gsublookupsubtable)
gsublookupsindex++
endloop
endif
gposlookupslength = SizeOf(GetLookups("GPOS"))
gposlookups = Array(gposlookupslength)
gposlookupsindex = 0
gposlookups = GetLookups("GPOS")
Print($fontname, "のGPOSルックアップテーブルは", gposlookups)
gposlookupslength = SizeOf(gposlookups)
while(gposlookupsindex < gposlookupslength)
gposlookupinformation = GetLookupInfo(gposlookups[gposlookupsindex])
gposlookupsubtable = GetLookupSubtables(gposlookups[gposlookupsindex])
Print($fontname, "のGPOSルックアップ、", gposlookups[gposlookupsindex], "のGPOSルックアップ情報は", gposlookupinformation)

gposlookupinformationlength = SizeOf(gposlookupinformation)
gposlookupinformationarray = Array(gposlookupinformationlength)
gposlookupinformationarray = gposlookupinformation
gposlookupinformationindex = 0
while(gposlookupinformationindex < gposlookupinformationlength)
gposlookupinformationstring = gposlookupinformationarray[gposlookupinformationindex]
Print($fontname, "のGPOSルックアップ情報の個別情報は",  gposlookupinformationstring)
gposlookupinformationindex++
endloop

Print($fontname, "のGPOSルックアップ、", gposlookups[gposlookupsindex], "のGPOSルックアップサブテーブルは", gposlookupsubtable)
gposlookupsindex++
endloop
Close()