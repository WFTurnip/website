languagesystem latn dflt;


# GPOS 


lookup mark {
  lookupflag 0;
  markClass [\A \E \I \O \U \W \a \e \i \o \u \w ] <anchor -250 200> @vowel;
  pos base [\B \C \D \F \G \H \J \K \L \M \N \P \Q \R \S \T \V \X \Y \Z \b \c \d \f \g \h \j \k \l \m \n \p \q \r \s \t \v \x \y \z \uni25CC ] <anchor 250 200> mark @vowel;
} mark;

feature mark {

 script latn;
     language dflt ;
      lookup mark;
} mark;
#Mark attachment classes (defined in GDEF, used in lookupflags)

@GDEF_Simple = [\B \C \D \F \G \H \J \K \L \M \N \P \Q \R \S \T \V \X \Y \Z \grave \b \c \d \f \g \h \j 
	\k \l \m \n \p \q \r \s \t \v \x \y \z \uni25CC ];
@GDEF_Mark = [\A \E \I \O \U \W \a \e \i \o \u \w \acutecomb \uni0317 \gravecomb \uni0316 
	\uni0302 \uni032D \uni030C \uni032C \uni0307 \dotbelowcomb \uni0308 \uni0324 
	\uni0304 \uni0331 ];

table GDEF {
  GlyphClassDef @GDEF_Simple, , @GDEF_Mark, ;

} GDEF;

