#!/usr/local/bin/fontforge
Open($1)
# AddLookup("mark", "gpos_mark2base", 0, [[ "mark", [[ "latn", ["dflt"] ]] ]])
# AddLookupSubtable("mark", "mark-1")
if(1 == CheckForAnchorClass("vowel"))
RemoveAnchorClass("vowel")
AddAnchorClass("vowel", "default", "mark-1")
endif
defaultwidth = 500
Print("基底グリフ幅は ", defaultwidth, "px です。")
markwidth = 0
Print("マークグリフ幅は ", markwidth, "px です。")
basecharanchorpointx = defaultwidth * 0.5
Print("衛星記号（朗唱記号）用基底グリフアンカーポイント座標（X軸）は ", basecharanchorpointx, "px です。")
markanchorpointx = defaultwidth * -0.5
Print("衛星記号（朗唱記号）用マークグリフアンカーポイント座標（X軸）は ", markanchorpointx, "px です。")
planetanchorpointy = $ascent - ($em / 2)
Print("衛星記号（朗唱記号）用アンカーポイント座標（Y軸）は ", planetanchorpointy, "px です。")
