#!/usr/local/bin/fontforge
Open($1);
# RemoveAnchorClass("Marks");
# RemoveLookupSubtable("mark-1");
# RemoveLookup("mark");
# AddLookup("mark", "gpos_mark2base", 0, [["mark", [["latn", ["dflt"]]]]]);
# AddLookupSubtable("mark", "mark-1");
# AddAnchorClass("Marks", "default", "mark-1");
DirectoryName = $filename:t:r;
BaseWidth = 500;
if($fontname == "Makina");
BaseWidth = 400;
endif;
MarkWidth = 0;
BaseGlyphAnchorPointX = BaseWidth * 0.5;
BaseGlyphAnchorPointY = $ascent - ($em / 2);
MarkGlyphAnchorPointX = BaseWidth * -0.5;
MarkGlyphAnchorPointY = $ascent - ($em / 2);
Print("あなたが開いたフォントファイルは ", DirectoryName, " です。");
Print("基底グリフ幅は ", BaseWidth, "px です。");
Print("マークグリフ幅は ", MarkWidth, "px です。");
Print("基底グリフアンカーポイント座標（X軸）は ", BaseGlyphAnchorPointX, "px です。");
Print("基底グリフアンカーポイント座標（Y軸）は ", BaseGlyphAnchorPointY, "px です。");
Print("マークグリフアンカーポイント座標（X軸）は ", MarkGlyphAnchorPointX, "px です。");
Print("マークグリフアンカーポイント座標（Y軸）は ", MarkGlyphAnchorPointY, "px です。");
Select(0u0041); SetGlyphClass("mark"); SetWidth(MarkWidth); Import("./" + DirectoryName + "/uni0041.svg", 0, 16); AddAnchorPoint("Marks", "mark", MarkGlyphAnchorPointX, MarkGlyphAnchorPointY);
Select(0u0045); SetGlyphClass("mark"); SetWidth(MarkWidth); Import("./" + DirectoryName + "/uni0045.svg", 0, 16); AddAnchorPoint("Marks", "mark", MarkGlyphAnchorPointX, MarkGlyphAnchorPointY);
Select(0u0049); SetGlyphClass("mark"); SetWidth(MarkWidth); Import("./" + DirectoryName + "/uni0049.svg", 0, 16); AddAnchorPoint("Marks", "mark", MarkGlyphAnchorPointX, MarkGlyphAnchorPointY);
Select(0u004f); SetGlyphClass("mark"); SetWidth(MarkWidth); Import("./" + DirectoryName + "/uni004f.svg", 0, 16); AddAnchorPoint("Marks", "mark", MarkGlyphAnchorPointX, MarkGlyphAnchorPointY);
Select(0u0055); SetGlyphClass("mark"); SetWidth(MarkWidth); Import("./" + DirectoryName + "/uni0055.svg", 0, 16); AddAnchorPoint("Marks", "mark", MarkGlyphAnchorPointX, MarkGlyphAnchorPointY);
Select(0u0057); SetGlyphClass("mark"); SetWidth(MarkWidth); Import("./" + DirectoryName + "/uni0057.svg", 0, 16); AddAnchorPoint("Marks", "mark", MarkGlyphAnchorPointX, MarkGlyphAnchorPointY);
Select(0u0061); SetGlyphClass("mark"); SetWidth(MarkWidth); Import("./" + DirectoryName + "/uni0061.svg", 0, 16); AddAnchorPoint("Marks", "mark", MarkGlyphAnchorPointX, MarkGlyphAnchorPointY);
Select(0u0065); SetGlyphClass("mark"); SetWidth(MarkWidth); Import("./" + DirectoryName + "/uni0065.svg", 0, 16); AddAnchorPoint("Marks", "mark", MarkGlyphAnchorPointX, MarkGlyphAnchorPointY);
Select(0u0069); SetGlyphClass("mark"); SetWidth(MarkWidth); Import("./" + DirectoryName + "/uni0069.svg", 0, 16); AddAnchorPoint("Marks", "mark", MarkGlyphAnchorPointX, MarkGlyphAnchorPointY);
Select(0u006f); SetGlyphClass("mark"); SetWidth(MarkWidth); Import("./" + DirectoryName + "/uni006f.svg", 0, 16); AddAnchorPoint("Marks", "mark", MarkGlyphAnchorPointX, MarkGlyphAnchorPointY);
Select(0u0075); SetGlyphClass("mark"); SetWidth(MarkWidth); Import("./" + DirectoryName + "/uni0075.svg", 0, 16); AddAnchorPoint("Marks", "mark", MarkGlyphAnchorPointX, MarkGlyphAnchorPointY);
Select(0u0077); SetGlyphClass("mark"); SetWidth(MarkWidth); Import("./" + DirectoryName + "/uni0077.svg", 0, 16); AddAnchorPoint("Marks", "mark", MarkGlyphAnchorPointX, MarkGlyphAnchorPointY);
Save($1);
Close();
Quit(0);