#!/usr/local/bin/fontforge
Open($1)
# RemoveAnchorClass("Marks")
# RemoveLookupSubtable("mark-1")
# RemoveLookup("mark")
# AddLookup("mark", "gpos_mark2base", 0, [["mark", [["latn", ["dflt"]]]]])
# AddLookupSubtable("mark", "mark-1")
# AddAnchorClass("Marks", "default", "mark-1")
AddLookup("mkmk", "gpos_mark2mark", 0, [["mark", [["latn", ["dflt"]]]]])
AddLookupSubtable("mkmk", "mkmk-1")
AddAnchorClass("AboveMark2Marks", "default", "mkmk-1")
AddAnchorClass("BelowMark2Marks", "default", "mkmk-1")
BaseWidth = 500
MarkWidth = 0
BaseGlyphBase2MarkAnchorPointX = BaseWidth * 0.5
BaseGlyphBase2MarkAnchorPointY = $ascent - ($em / 2)
MarkGlyphBase2MarkAnchorPointX = BaseWidth * -0.5
MarkGlyphBase2MarkAnchorPointY = $ascent - ($em / 2)
AboveMark2MarkAnchorPointX = BaseWidth * -0.5
AboveMark2MarkAnchorPointY = $ascent - $descent / 2
BelowMark2MarkAnchorPointX = BaseWidth * -0.5
BelowMark2MarkAnchorPointY = -1 * $descent / 2
Print("基底グリフ幅は ", BaseWidth, "px です。")
Print("マークグリフ幅は ", MarkWidth, "px です。")
Print("基底グリフアンカーポイント座標（X軸）は ", BaseGlyphBase2MarkAnchorPointX, "px です。")
Print("基底グリフアンカーポイント座標（Y軸）は ", BaseGlyphBase2MarkAnchorPointY, "px です。")
Print("マークグリフアンカーポイント座標（X軸）は ", MarkGlyphBase2MarkAnchorPointX, "px です。")
Print("マークグリフアンカーポイント座標（Y軸）は ", MarkGlyphBase2MarkAnchorPointY, "px です。")
Print("上部マークマークグリフアンカーポイント座標（X軸）は", AboveMark2MarkAnchorPointX, "px です。")
Print("上部マークマークグリフアンカーポイント座標（Y軸）は", AboveMark2MarkAnchorPointY, "px です。")
Print("下部マークマークグリフアンカーポイント座標（X軸）は", BelowMark2MarkAnchorPointX, "px です。")
Print("下部マークマークグリフアンカーポイント座標（Y軸）は", BelowMark2MarkAnchorPointY, "px です。")
