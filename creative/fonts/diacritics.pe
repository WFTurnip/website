BaseWidth = 500;
MarkWidth = 0;
BaseGlyphB2MAnchorPointX = BaseWidth * 0.5;
BaseGlyphB2MAnchorPointY = $ascent - ($em / 2);
MarkGlyphB2MAnchorPointX = BaseWidth * -0.5;
MarkGlyphB2MAnchorPointY = $ascent - ($em / 2);
AboveM2MAnchorPointX = BaseWidth * -0.5;
AboveM2MAnchorPointY = $ascent - $descent / 2;
BelowM2MAnchorPointX = BaseWidth * -0.5;
BelowM2MAnchorPointY = -1 * $descent / 2;
Print("基底グリフ幅は ", BaseWidth, "px です。");
Print("マークグリフ幅は ", MarkWidth, "px です。");
Print("基底グリフアンカーポイント座標（X軸）は ", BaseGlyphB2MAnchorPointX, "px です。");
Print("基底グリフアンカーポイント座標（Y軸）は ", BaseGlyphB2MAnchorPointY, "px です。");
Print("マークグリフアンカーポイント座標（X軸）は ", MarkGlyphB2MAnchorPointX, "px です。");
Print("マークグリフアンカーポイント座標（Y軸）は ", MarkGlyphB2MAnchorPointY, "px です。");
Print("上部マークマークグリフアンカーポイント座標（X軸）は", AboveM2MAnchorPointX, "px です。");
Print("上部マークマークグリフアンカーポイント座標（Y軸）は", AboveM2MAnchorPointY, "px です。");
Print("下部マークマークグリフアンカーポイント座標（X軸）は", BelowM2MAnchorPointX, "px です。");
Print("下部マークマークグリフアンカーポイント座標（Y軸）は", BelowM2MAnchorPointY, "px です。");
Select(0u0301); SetGlyphClass("mark"); SetWidth(MarkWidth); Import("./lekuta/uni0301.svg", 0, 16); AddAnchorPoint("Marks", "mark", MarkGlyphB2MAnchorPointX, MarkGlyphB2MAnchorPointY); AddAnchorPoint("AboveMarks", "mark", AboveM2MAnchorPointX, AboveM2MAnchorPointY);
Select(0u0300); SetGlyphClass("mark"); SetWidth(MarkWidth); Import("./lekuta/uni0300.svg", 0, 16); AddAnchorPoint("Marks", "mark", MarkGlyphB2MAnchorPointX, MarkGlyphB2MAnchorPointY); AddAnchorPoint("AboveMarks", "mark", AboveM2MAnchorPointX, AboveM2MAnchorPointY);
