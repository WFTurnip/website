#!/usr/local/bin/fontforge
Open($1);
# RemoveAnchorClass("Marks");
# RemoveLookupSubtable("mark-1");
# RemoveLookup("mark");
# AddLookup("mark", "gpos_mark2base", 0, [["mark", [["latn", ["dflt"]]]]]);
# AddLookupSubtable("mark", "mark-1");
# AddAnchorClass("Marks", "default", "mark-1");
DirectoryName = $filename:t:r;
BaseWidth = 500;
if($fontname == "Makina");
BaseWidth = 400;
endif;
MarkWidth = 0;
BaseGlyphAnchorPointX = BaseWidth * 0.5;
BaseGlyphAnchorPointY = $ascent - ($em / 2);
MarkGlyphAnchorPointX = BaseWidth * -0.5;
MarkGlyphAnchorPointY = $ascent - ($em / 2);
Print("あなたが開いたフォントファイルは ", DirectoryName, " です。");
Print("基底グリフ幅は ", BaseWidth, "px です。");
Print("マークグリフ幅は ", MarkWidth, "px です。");
Print("基底グリフアンカーポイント座標（X軸）は ", BaseGlyphAnchorPointX, "px です。");
Print("基底グリフアンカーポイント座標（Y軸）は ", BaseGlyphAnchorPointY, "px です。");
Print("マークグリフアンカーポイント座標（X軸）は ", MarkGlyphAnchorPointX, "px です。");
Print("マークグリフアンカーポイント座標（Y軸）は ", MarkGlyphAnchorPointY, "px です。");
Select(0u02ca); SetGlyphClass("mark"); SetWidth(MarkWidth); Import("./" + DirectoryName + "uni02ca.svg", 0, 16);
Select(0u02cf); SetGlyphClass("mark"); SetWidth(MarkWidth); Import("./" + DirectoryName + "uni02cf.svg", 0, 16);
Select(0u02cb); SetGlyphClass("mark"); SetWidth(MarkWidth); Import("./" + DirectoryName + "uni02cb.svg", 0, 16);
Select(0u02ce); SetGlyphClass("mark"); SetWidth(MarkWidth); Import("./" + DirectoryName + "uni02ce.svg", 0, 16);
Select(0u02c6); SetGlyphClass("mark"); SetWidth(MarkWidth); Import("./" + DirectoryName + "uni02c6.svg", 0, 16);
Select(0ua788); SetGlyphClass("mark"); SetWidth(MarkWidth); Import("./" + DirectoryName + "unia788.svg", 0, 16);
Select(0u02c7); SetGlyphClass("mark"); SetWidth(MarkWidth); Import("./" + DirectoryName + "uni02c7.svg", 0, 16);
Select(0u02ec); SetGlyphClass("mark"); SetWidth(MarkWidth); Import("./" + DirectoryName + "uni02ec.svg", 0, 16);
Select(0u02c9); SetGlyphClass("mark"); SetWidth(MarkWidth); Import("./" + DirectoryName + "uni02c9.svg", 0, 16);
Select(0u02cd); SetGlyphClass("mark"); SetWidth(MarkWidth); Import("./" + DirectoryName + "uni02cd.svg", 0, 16);
Save($1);
Close();
Quit(0);